{
    "version": 2,
    "builds": [
        {
            "src": "python_backend/ecommerce_backend/api/index.py",
            "use": "@vercel/python",
            "config": {
                "requirementsFile": "python_backend/ecommerce_backend/requirements.txt"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "python_backend/ecommerce_backend/api/index.py"
        }
    ]
}